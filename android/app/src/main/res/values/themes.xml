<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DepositRelay" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#0F1720</item>
        <item name="android:windowBackground">#0F1720</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8B9BB0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#1D2836</item>
        <item name="android:textColor">#E8EDF4</item>
        <item name="android:textColorHint">#5B6b7d</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Check">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#E8EDF4</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#3B82F6</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Ghost">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">#26313F</item>
        <item name="android:textColor">#E8EDF4</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
