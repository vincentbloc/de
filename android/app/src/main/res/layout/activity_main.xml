<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F1720">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="입금알림 전달 설정"
            android:textColor="#E8EDF4"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이 휴대폰의 입금 문자·앱 알림을 매장 서버로 보냅니다."
            android:textColor="#8B9BB0"
            android:textSize="13sp"
            android:paddingBottom="14dp" />

        <TextView style="@style/Label" android:text="서버 주소 (…/api/ingest.php)" />
        <EditText android:id="@+id/etUrl" style="@style/Field"
            android:hint="https://내주소/api/ingest.php"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="전송 토큰 (서버 config.php의 값과 동일)" />
        <EditText android:id="@+id/etToken" style="@style/Field"
            android:hint="긴 무작위 토큰" android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="이 기기 이름" />
        <EditText android:id="@+id/etName" style="@style/Field"
            android:hint="매장 카운터폰" android:inputType="text" />

        <CheckBox android:id="@+id/cbSms" style="@style/Check"
            android:text="문자(SMS) 입금 알림 전달" />
        <CheckBox android:id="@+id/cbNoti" style="@style/Check"
            android:text="앱 알림 전달 (토스·카카오뱅크 등)" />
        <CheckBox android:id="@+id/cbAll" style="@style/Check"
            android:text="지정 은행앱 외 다른 앱의 입금 알림도 전달" />

        <Button android:id="@+id/btnSave" style="@style/Primary"
            android:text="저장하고 시작" />

        <Button android:id="@+id/btnTest" style="@style/Ghost"
            android:text="서버 연결 테스트" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#2A3646" android:layout_marginVertical="14dp" />

        <TextView style="@style/Label" android:text="권한 설정" />
        <Button android:id="@+id/btnSms" style="@style/Ghost"
            android:text="1) 문자 수신 권한 허용" />
        <Button android:id="@+id/btnNoti" style="@style/Ghost"
            android:text="2) 알림 접근 허용 (토스·카카오용)" />
        <Button android:id="@+id/btnBattery" style="@style/Ghost"
            android:text="3) 배터리 최적화 제외 (항상 켜두기)" />

        <TextView android:id="@+id/tvStatus" style="@style/Label"
            android:layout_marginTop="12dp"
            android:textColor="#86EFAC"
            android:text="상태 확인 중…" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#2A3646" android:layout_marginVertical="14dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/Label" android:layout_weight="1"
                android:layout_width="0dp" android:text="최근 전달 기록" />
            <Button android:id="@+id/btnRefresh" style="@style/Ghost"
                android:layout_width="wrap_content" android:text="새로고침" />
        </LinearLayout>

        <TextView android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161F2B"
            android:padding="12dp"
            android:textColor="#C7D2DE"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="" />

    </LinearLayout>
</ScrollView>
